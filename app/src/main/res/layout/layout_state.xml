<?xml version="1.0" encoding="utf-8"?>
<!--
    Lớp phủ trạng thái dùng chung: loading / rỗng / lỗi mạng.
    Cả 3 khối đều ẩn mặc định, bật bằng show() / gone() (xem StateViews.kt).
    Đặt bên trong FrameLayout, phía trên RecyclerView.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/stateRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. LOADING -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/green_dark"
            app:indicatorSize="48dp"
            app:trackColor="@color/green_light"
            app:trackThickness="5dp" />

        <TextView
            android:id="@+id/tvLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Đang tìm món ngon cho bạn..."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 2. KHÔNG CÓ KẾT QUẢ -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="104dp"
            android:layout_height="104dp"
            app:cardBackgroundColor="@color/green_light"
            app:cardCornerRadius="52dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivEmpty"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_state_empty"
                app:tint="@color/green_dark" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Chưa tìm thấy món phù hợp"
            android:textColor="@color/gray_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmptyMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Thử thêm nguyên liệu hoặc bỏ bớt bộ lọc nhé"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 3. LỖI MẠNG -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="104dp"
            android:layout_height="104dp"
            app:cardBackgroundColor="#FFF1E3"
            app:cardCornerRadius="52dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivError"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_state_error"
                app:tint="@color/orange" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvErrorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Không có kết nối mạng"
            android:textColor="@color/gray_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Kiểm tra lại Wi-Fi hoặc dữ liệu di động rồi thử lại nhé"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:paddingHorizontal="28dp"
            android:text="Thử lại"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:backgroundTint="@color/green_dark"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_refresh"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/white" />
    </LinearLayout>
</FrameLayout>